# Django
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DEMO_MODE=true

# Optional: Travelpayouts Data API (frontend already uses White Label wl_id=17018)
TRAVELPAYOUTS_TOKEN=
TRAVELPAYOUTS_MARKER=571353

# Database
POSTGRES_DB=travellab
POSTGRES_USER=travellab
POSTGRES_PASSWORD=travellab
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
# Set USE_SQLITE=true to skip Docker Postgres during local UI work
USE_SQLITE=false

# CORS / Frontend
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
FRONTEND_URL=http://localhost:3000

# JWT
JWT_ACCESS_MINUTES=60
JWT_REFRESH_DAYS=7

# Next.js
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000/api/v1
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_DEMO_MODE=true
